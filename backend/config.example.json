{
  "installation": {
    "completed": false
  },
  "secrets": {
    "encryption_key": "",
    "session_key": null
  },
  "application": {
    "frontend_dir": "../frontend",
    "database_path": "data/switchsteward.db",
    "sqlite_timeout_seconds": 10,
    "api_max_body_bytes": 65536,
    "audit_log_limit": 200
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8000,
    "log_level": "info",
    "tls": {
      "enabled": false,
      "generate_self_signed": false,
      "cert_file": null,
      "key_file": null
    }
  },
  "session": {
    "cookie_name": "switchsteward_session",
    "cookie_secure": false,
    "max_age_seconds": 3600,
    "login_max_failures": 5,
    "login_window_seconds": 900,
    "login_max_tracked_keys": 10000
  },
  "ssh": {
    "strict_host_keys": true,
    "known_hosts_file": null,
    "timeout_seconds": 10,
    "allow_legacy_algorithms": false
  },
  "wireless": {
    "allow_unverified_restconf_tls": false,
    "restconf_ca_cert_file": null,
    "netconf_strict_host_keys": true,
    "netconf_known_hosts_file": null,
    "netconf_allow_legacy_algorithms": false,
    "connect_timeout_seconds": 5,
    "read_timeout_seconds": 30,
    "cache_ttl_seconds": 30,
    "max_response_bytes": 10485760
  },
  "switch_api": {
    "ca_cert_file": null,
    "allow_unverified_tls": false,
    "timeout_seconds": 10
  },
  "logging": {
    "directory": "logs",
    "level": "info",
    "max_bytes": 10485760,
    "backup_count": 10
  }
}
